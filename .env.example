# Copie este arquivo para .env (Docker/compose) ou .env.local (dev) e preencha.
# NÃO faça commit do arquivo preenchido.

# --- Supabase (client + servidor) ---
# NEXT_PUBLIC_* são embutidas no bundle do browser em tempo de BUILD.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-SUPABASE
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Schema do banco de dados (Postgres)
NEXT_PUBLIC_SUPABASE_SCHEMA=chat_gtgestao

# Service role — SOMENTE servidor (rotas /api e scripts). Nunca vai ao client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Conexão Postgres (Prisma / psql). Ex. pooler:
# postgresql://postgres.<ref>:<SENHA>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:SENHA@HOST:5432/postgres"
